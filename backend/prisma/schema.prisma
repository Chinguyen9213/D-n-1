model Task {
  id          String   @id @default(uuid()) // Hoặc kiểu Int tùy cấu hình hiện tại của bạn
  title       String
  description String?
  status      String   @default("todo")
  assignee    String?
  priority    String   @default("medium")
  dueDate     DateTime?
  
  // 👉 Thêm trường này để lưu danh sách file đính kèm dưới dạng JSON array
  attachments Json?    @default("[]") 
  
  projectId   String
  // Các quan hệ khác (nếu có)
}
